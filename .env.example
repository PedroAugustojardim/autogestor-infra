# ─── Redis (usado pelo docker-compose.yml) ────────────────────────────────────
# Senha do container Redis (autogestor-cache) e do bull-board (autogestor-queue).
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REDIS_PASSWORD=

# ─── bull-board (dashboard das filas, porta 3001) ─────────────────────────────
# Sem os dois setados, o board fica sem login — ele mostra o payload dos jobs,
# então isso não pode ficar em branco fora de localhost.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=

# ─── Valor de referência p/ autogestor-api/.env (REDIS_URL) ──────────────────
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379
